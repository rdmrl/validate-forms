{
  "name": "validate-forms",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/validate-forms.js",
      "require": "./dist/validate-forms.cjs"
    }
  },
  "main": "./dist/validate-forms.cjs",
  "module": "./dist/validate-forms.js",
  "types": "./dist/validate-forms.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript-7/bin/tsc --noEmit && vite build",
    "release": "pnpm test && pnpm build && changelogen --release --push && pnpm publish",
    "lint": "eslint . --fix",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "prepare": "husky install",
    "versions": "node -p \"JSON.stringify({ node: process.version, eslint: require('./node_modules/eslint/package.json').version, typescriptEslint: require('./node_modules/typescript-eslint/package.json').version, typescriptForEslint: require('./node_modules/typescript/package.json').version, typescript7: require('./node_modules/typescript-7/package.json').version }, null, 2)\""
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "camelcase": "^9.0.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.69.0",
    "unplugin-dts": "^1.1.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.ts": "pnpm run lint"
  }
}
